# =============================================================================
# OWNER: Platform Engineering
# =============================================================================
#
# .env.testbed — Platform Engineer operator input for the OpenBao seed job.
#
# This file defines the secret values that will be written to OpenBao under
# secret/testbed/<system>/<set>. It is maintained per test environment by the
# Platform Engineering team.
#
# DO NOT COMMIT .env.testbed — it is gitignored.
# COMMIT .env.testbed.example — it defines the public contract with plugin authors.
#
# Usage:
#   cp .env.testbed.example .env.testbed
#   # Fill in the values you have; leave others blank to skip those paths.
#   make platform-openbao-seed
#
# Rules enforced by the seed job:
#   - Blank single-value secret → path is NOT written (not deleted either)
#   - Credential bundles with any blank required field → path is NOT written
#   - Existing path → preserved unless FORCE=true (make platform-openbao-seed FORCE=true)
#   - secret/demo/* → always written with deterministic placeholder values
#   - secret/scratch/* → never touched by the seed job
#
# =============================================================================


# ── LiteLLM ──────────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/litellm/mistral → { api_key }
# Obtain from: https://console.mistral.ai → API Keys
LITELLM_MISTRAL_API_KEY=

# OpenBao path: secret/testbed/litellm/openai → { api_key }
# Obtain from: https://platform.openai.com → API Keys
LITELLM_OPENAI_API_KEY=

# OpenBao path: secret/testbed/litellm/anthropic → { api_key }
# Obtain from: https://console.anthropic.com → API Keys
LITELLM_ANTHROPIC_API_KEY=

# OpenBao path: secret/testbed/litellm/azure-openai → { api_key, api_base, api_version }
# Obtain from: Azure Portal → Cognitive Services → Keys and Endpoint
# All three values are required; leave any blank to skip this path entirely.
LITELLM_AZURE_OPENAI_API_KEY=
LITELLM_AZURE_OPENAI_API_BASE=
LITELLM_AZURE_OPENAI_API_VERSION=


# ── MLflow ───────────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/mlflow/s3 → { access_key, secret_key, endpoint_url }
# Used when configuring an S3-compatible artifact store for MLflow.
# All three values are required; leave any blank if using the default local filesystem artifact store.
# Obtain from: your MinIO/S3 admin or AWS IAM console.
MLFLOW_S3_ACCESS_KEY=
MLFLOW_S3_SECRET_KEY=
MLFLOW_S3_ENDPOINT_URL=


# ── OpenMetadata ─────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/openmetadata/admin → { username, password }
# Default testbed admin credentials for the OpenMetadata instance.
# Both values are required; a blank password skips this path.
OPENMETADATA_ADMIN_USERNAME=admin
OPENMETADATA_ADMIN_PASSWORD=


# ── ArgoCD ───────────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/argocd/admin → { username, password }
# Default testbed admin credentials for the ArgoCD instance.
# Both values are required; a blank password skips this path.
ARGOCD_ADMIN_USERNAME=admin
ARGOCD_ADMIN_PASSWORD=


# ── Grafana LGTM ─────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/grafana/admin → { username, password }
# Default testbed admin credentials for the Grafana instance.
# Both values are required; a blank password skips this path.
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=


# ── Langfuse ─────────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/langfuse/api → { public_key, secret_key, host }
# Obtain from: Langfuse project settings → API Keys.
# Set HOST to the in-cluster service URL if self-hosted.
# All three values are required; leave any blank to skip this path.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse.naira-testbed-langfuse.svc.cluster.local:3000


# ── KServe / vLLM ────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/kserve/model-registry → { url, token }
# URL of the model registry API endpoint. Token for authenticated access.
# Both values are required; a blank value skips this path.
KSERVE_MODEL_REGISTRY_URL=
KSERVE_MODEL_REGISTRY_TOKEN=


# ── OpenDataHub ──────────────────────────────────────────────────────────────
# OpenBao path: secret/testbed/opendatahub/admin → { username, password }
# Default testbed admin credentials for the OpenDataHub instance.
# Both values are required; a blank password skips this path.
OPENDATAHUB_ADMIN_USERNAME=admin
OPENDATAHUB_ADMIN_PASSWORD=
